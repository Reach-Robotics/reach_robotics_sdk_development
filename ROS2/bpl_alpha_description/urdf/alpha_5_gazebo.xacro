<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="gazebo_color_alpha_black" params="link_name">
    <gazebo reference="${link_name}">
        <visual>
        <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <emissive>0 0 0 1</emissive>
        </material>
        </visual>
    </gazebo>
    </xacro:macro>

    <gazebo reference="alpha_base_link">
        <static>true</static>
    </gazebo>

    <xacro:gazebo_color_alpha_black link_name="alpha_base_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_m3_inline_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_m2_1_1_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_m2_joint_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_m2_1_2_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_m1_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_standard_jaws_base_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_standard_jaws_rs1_130_link"/>
    <xacro:gazebo_color_alpha_black link_name="alpha_standard_jaws_rs1_139_link"/>

    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
            <parameters>$(find bpl_alpha_description)/config/alpha_5_controllers.yaml</parameters>
        </plugin>
    </gazebo>
    
</robot>